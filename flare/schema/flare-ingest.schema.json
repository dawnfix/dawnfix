{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawnfix.dev/schema/flare-ingest.schema.json",
  "title": "dawnfix.flare/1",
  "description": "What one Dawnfix Flare CI run sends to the hosted service (POST /v1/flare, only with an Enterprise key): counts per check and severity, how many Cloudflare accounts were audited and a salted SHA-256 id per account. Every object is closed and every value is a count, an enum or a fixed-shape string, so no hostname, script, zone, token, secret or account name can be carried. Names stay in the run job summary in the customer GitHub. Source available under FSL-1.1-ALv2 (see LICENSE at the repo root).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "accounts",
    "account_ids",
    "local_files",
    "gaps",
    "summary",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "dawnfix.flare/1"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "maxLength": 20
    },
    "accounts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "account_ids": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$"
      }
    },
    "local_files": {
      "$ref": "#/$defs/count"
    },
    "gaps": {
      "$ref": "#/$defs/count"
    },
    "summary": {
      "$ref": "#/$defs/severities"
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workers-dev-enabled",
        "preview-urls-enabled",
        "hostname-without-auth",
        "ratelimit-namespace-shared",
        "route-to-missing-script",
        "dangling-dns",
        "dead-script",
        "compat-date-old",
        "secrets-changed",
        "token-over-scoped",
        "token-no-expiry",
        "token-unused",
        "zone-tls"
      ],
      "properties": {
        "workers-dev-enabled": {
          "$ref": "#/$defs/severities"
        },
        "preview-urls-enabled": {
          "$ref": "#/$defs/severities"
        },
        "hostname-without-auth": {
          "$ref": "#/$defs/severities"
        },
        "ratelimit-namespace-shared": {
          "$ref": "#/$defs/severities"
        },
        "route-to-missing-script": {
          "$ref": "#/$defs/severities"
        },
        "dangling-dns": {
          "$ref": "#/$defs/severities"
        },
        "dead-script": {
          "$ref": "#/$defs/severities"
        },
        "compat-date-old": {
          "$ref": "#/$defs/severities"
        },
        "secrets-changed": {
          "$ref": "#/$defs/severities"
        },
        "token-over-scoped": {
          "$ref": "#/$defs/severities"
        },
        "token-no-expiry": {
          "$ref": "#/$defs/severities"
        },
        "token-unused": {
          "$ref": "#/$defs/severities"
        },
        "zone-tls": {
          "$ref": "#/$defs/severities"
        }
      }
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "severities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "properties": {
        "critical": {
          "$ref": "#/$defs/count"
        },
        "high": {
          "$ref": "#/$defs/count"
        },
        "medium": {
          "$ref": "#/$defs/count"
        },
        "low": {
          "$ref": "#/$defs/count"
        },
        "info": {
          "$ref": "#/$defs/count"
        }
      }
    }
  }
}
