{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shop",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01", // keep in step with the runtime
  /* workers_dev is not set: with routes it defaults to false */
  "routes": [{ "pattern": "shop.example.com", "custom_domain": true }],
  "ratelimits": [
    { "name": "PAGE_LIMIT", "namespace_id": "1001", "simple": { "limit": 100, "period": 60 } },
  ],
}
