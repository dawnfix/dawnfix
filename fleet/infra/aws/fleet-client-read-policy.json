{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AlarmsInAlarm",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DescribeAlarms"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ListCertificates",
      "Effect": "Allow",
      "Action": [
        "acm:ListCertificates"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CertificateExpiry",
      "Effect": "Allow",
      "Action": [
        "acm:DescribeCertificate"
      ],
      "Resource": "arn:aws:acm:*:CLIENT_ACCOUNT_ID:certificate/*"
    },
    {
      "Sid": "DailySpend",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage"
      ],
      "Resource": "*"
    }
  ]
}
