{
  "currency": "USD",
  "source": {
    "primary": "AWS Price List bulk API, offer AmazonCloudWatch, https://pricing.us-east-1.amazonaws.com/offers/v1.0/aws/AmazonCloudWatch/current/<region>/index.json",
    "publication_date": "2026-10-07",
    "retrieved": "2026-10-27",
    "cross_check": "https://aws.amazon.com/cloudwatch/pricing/ (worked examples: $0.50/GB Standard ingestion, $0.25/GB Infrequent Access, $0.03/GB-month storage, vended tiers 0.50/0.25/0.10/0.05, all US East N. Virginia); Logs Insights $0.005/GB scanned confirmed by third-party guides",
    "usage_types": {
      "ingest_standard_gb": "<REGION>-DataProcessing-Bytes",
      "ingest_ia_gb": "<REGION>-DataProcessingIA-Bytes",
      "storage_gb_month": "<REGION>-TimedStorage-ByteHrs",
      "insights_scanned_gb": "<REGION>-DataScanned-Bytes",
      "vended_standard_tiers": "<REGION>-VendedLog-Bytes",
      "vended_ia_tiers": "<REGION>-VendedLogIA-Bytes"
    }
  },
  "free_tier": {
    "gb_per_month": 5,
    "note": "5 GB per month shared across ingestion, archive storage and Logs Insights scanned (Global-DataProcessing-Bytes / Global-DataScanned-Bytes). Applied once to the account total, never per group."
  },
  "tiers_note": "Tier rows are [up_to_GB_per_month, USD_per_GB]; null means no upper bound. Vended logs (Lambda, VPC Flow Logs, Route 53 resolver, API Gateway access logs and other AWS-service logs) are priced on these tiers per account per region per month; tiers reset monthly.",
  "default_region": "us-east-1",
  "uncertain": [
    "Which log groups AWS bills as vended is decided by the delivering service, not the group name. logbill guesses from the name prefix (vended_prefixes); a custom group that a service delivers into is billed vended but counted as custom here.",
    "vended_prefixes is deliberately short: Lambda logs are vended-priced since May 2025 and /aws/vendedlogs/ is the prefix AWS recommends for vended deliveries; VPC Flow Logs, Route 53 resolver and API Gateway logs land in groups of any name. At the first tier (up to 10 TB/month) vended and custom Standard ingestion cost the same in every listed region, so the guess only matters above 10 TB.",
    "storedBytes from DescribeLogGroups is used as the billed storage. AWS bills archive storage on compressed bytes; whether storedBytes is the compressed figure is not stated in the API reference.",
    "Regions not listed here fall back to default_region prices and are marked approximate in the report.",
    "The Insights cost estimate assumes a query scans about the bytes ingested in its window (IncomingBytes). Real bytesScanned can differ; logbill reads it from GetQueryResults and stops at the budget.",
    "Log groups in the DELIVERY class are not priced (they hold logs on the way to S3/Firehose and are billed per delivery)."
  ],
  "vended_prefixes": [
    "/aws/lambda/",
    "/aws/vendedlogs/"
  ],
