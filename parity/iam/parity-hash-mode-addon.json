{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ParityHashModeValues",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameters",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:ssm:*:*:parameter/REPLACE/WITH/YOUR/PREFIX/*",
        "arn:aws:secretsmanager:*:*:secret:REPLACE/WITH/YOUR/PREFIX/*"
      ]
    },
    {
      "Sid": "ParityHashModeDecrypt",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "kms:ViaService": [
            "ssm.*.amazonaws.com",
            "secretsmanager.*.amazonaws.com"
          ]
        }
      }
    }
  ]
}
