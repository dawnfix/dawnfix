{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dawnfix.dev/schema/receipt-ingest.schema.json",
  "title": "Dawnfix Receipt ingest (dawnfix.receipt/1)",
  "description": "What the dawnfix-receipt.yml workflow sends to POST /v1/receipt (only with an Enterprise key): per deploy, a hashed id, the UTC day, how complete the comparison is, the $/day change in cents snapped down to a 1-2-5 grid, and the AWS product family that moved most. No commit SHA, usage type, tag, resource, account or repo name, and no before/after totals. Written by receipt --ingest-out (src/dawnfix_receipt/ingest.py).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "deploys"
  ],
  "properties": {
    "schema": {
      "const": "dawnfix.receipt/1"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "deploys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/deploy"
      }
    }
  },
  "$defs": {
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploy_id",
        "deployed_on",
        "window_days",
        "after_days",
        "final",
        "material",
        "delta_cents_per_day_bucket",
        "top_driver"
      ],
      "properties": {
        "deploy_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$",
          "description": "16 hex of SHA-256 over \"dawnfix.receipt/1:\" + the commit SHA: an id, not the SHA"
        },
        "deployed_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "window_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "after_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30,
          "description": "settled after-days compared so far (<= window_days)"
        },
        "final": {
          "type": "boolean",
          "description": "every after-day has settled; false = provisional"
        },
        "material": {
          "type": "boolean",
          "description": "the change cleared max($1/day, 3% of baseline, 2x baseline spread)"
        },
        "delta_cents_per_day_bucket": {
          "type": "integer",
          "enum": [
            -500000000,
            -200000000,
            -100000000,
            -50000000,
            -20000000,
            -10000000,
            -5000000,
            -2000000,
            -1000000,
            -500000,
            -200000,
            -100000,
            -50000,
            -20000,
            -10000,
            -5000,
            -2000,
            -1000,
            -500,
            -200,
            -100,
            0,
            100,
            200,
            500,
            1000,
            2000,
            5000,
            10000,
            20000,
            50000,
            100000,
            200000,
            500000,
            1000000,
            2000000,
            5000000,
            10000000,
            20000000,
            50000000,
            100000000,
            200000000,
            500000000
          ],
          "description": "signed cents per day, snapped toward zero: 2000 means +$20 up to +$50 a day"
        },
        "top_driver": {
          "type": "string",
          "enum": [
            "api_gateway",
            "bedrock",
            "cloudfront",
            "cloudwatch",
            "data_transfer",
            "dynamodb",
            "ec2_compute",
            "ec2_other",
            "ecr",
            "ecs",
            "eks",
            "elasticache",
            "elb",
            "kinesis",
            "kms",
            "lambda",
            "none",
            "opensearch",
            "other",
            "rds",
            "route53",
            "s3",
            "sagemaker",
            "secrets_manager",
            "sqs",
            "step_functions",
            "vpc"
          ],
          "description": "AWS product family that moved most in the direction of the change; none when not material"
        }
      }
    }
  }
}
